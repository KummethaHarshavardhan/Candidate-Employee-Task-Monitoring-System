# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/candidate_task_monitoring_db
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/candidate_task_monitoring_test_db

# JWT Authentication & Password Reset Security
JWT_SECRET=your_strong_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_AUTH_EXPIRES_MINUTES=10

# Initial Production Administrator Bootstrap (optional on fresh database)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Optional email delivery for assignment and submission notifications (Gmail or custom SMTP)
# Option A: Gmail or direct email credentials
EMAIL=your_email@gmail.com
EMAIL_PASS=your_email_app_password


# Option B: Custom SMTP server
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourcompany.com
SMTP_PASS=change_this_to_your_smtp_password
MAIL_FROM=notifications@yourcompany.com

